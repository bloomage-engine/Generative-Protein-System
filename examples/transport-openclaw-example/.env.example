# OpenClaw gateway — the transport-openclaw adapter connects as an operator
# client with the shared token (see services/transport-service/.env for a
# working reference).
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# The gateway session this example talks to (defaults to agent:main:main).
OPENCLAW_DEFAULT_SESSION=agent:main:main

# Example server port (defaults to 3200; the Vite dev server stays on 5173).
PORT=3200
