{
  "name": "@gps/transport-dsh-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server.ts",
    "dev:web": "node wait-for-server.mjs && vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@assistant-ui/react-markdown": "^0.14.14",
    "@gps/transport": "*",
    "@gps/transport-client": "*",
    "@gps/transport-dsh": "*",
    "@gps/transport-service": "*",
    "assistant-stream": "^0.3.41",
    "dotenv": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
