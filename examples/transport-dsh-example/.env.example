# The adapter spawns `dsh --profile sdk` as a local harness subprocess and the
# harness reaches the DeepSeek API with this key.
DEEPSEEK_API_KEY=

# Model route the harness sessions run on. These two names are promoted to the
# adapter's launch environment (`DSH_PROVIDER`/`DSH_MODEL`) by `server.ts` — an
# EXPORTED `DSH_*` still wins over them. Point the route at any OpenAI-compatible
# gateway; the default below is a LAN ollama.
HARNESS_PROVIDER=ollama-local
HARNESS_MODEL=qwen3.8:latest

# The route's `apiKeyEnv` (`llm-pi-ai.providers.<route>.apiKeyEnv`). Gateways
# that ignore the bearer (ollama) still need the NAME set to a non-empty value —
# the route resolves its credential per request and fails with
# MISSING_CREDENTIAL when it is unset or empty.
OLLAMA_LOCAL_API_KEY=ollama

# dsh treats every DSH_* name as LAUNCH-ONLY: the harness child runs with this
# folder as its cwd, so the dsh CLI boot layer reads THIS file too — and aborts
# on any DSH_* (or XDG_*/DYLD_*/...) assignment here. Keep this file free of
# DSH_* keys. To override launch settings, export them in the shell before
# `npm run dev` (e.g. `export DSH_HOME=~/.dsh DSH_MODEL=deepseek-v4-flash`).
# Defaults when nothing is set: profile `sdk`, home `~/.dsh`, provider
# `deepseek-official`, model `deepseek-v4-flash`, agent workspace = this folder,
# transcript mirror under the service tmp dir. DSH_TRANSCRIPT_DIR (mirror) and
# DSH_DEFAULT_SESSION (which conversation to resume) are DSH_* too — export
# them if you want them.
#
# The provider ROUTE (endpoint + models + credential name) is harness-side
# configuration, not a `.env` entry: add it to `<harness home>/settings.yaml`
# (~/.dsh/settings.yaml):
#
#   llm-pi-ai:
#     providers:
#       ollama-local:
#         api: openai-completions
#         baseURL: http://localhost:11434/v1
#         models: [{ id: qwen3.8:latest }]
#         apiKeyEnv: OLLAMA_LOCAL_API_KEY
