{
  "name": "@science-studio/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Science Studio desktop app",
  "author": "zhonghua-wang <zhonghua.wang@outlook.com>",
  "homepage": "https://hx-engine.com",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b",
    "build:host": "node scripts/build-host.mjs",
    "build:web": "npm --prefix ../.. run build:web:standalone",
    "build:desktop": "npm run build:host && npm run build:web",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "dev": "npm run build && node scripts/run-electron.mjs --dev",
    "start": "npm run build && npm run build:desktop && node scripts/run-electron.mjs",
    "pack": "npm --prefix ../.. run build && npm run build && npm run build:desktop && electron-builder"
  },
  "dependencies": {
    "@science-studio/transport": "*",
    "@science-studio/transport-dsh": "*",
    "@science-studio/transport-service": "*"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
