{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.cts"],
  "exclude": ["src/renderer"],
  "references": [
    { "path": "../../packages/transport" },
    { "path": "../../services/transport-service" }
  ]
}
