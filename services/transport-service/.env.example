# Copy to `.env` and fill in. Loaded by dotenv at service startup.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=<shared-gateway-token>
# Optional: default gateway session used for fresh threads.
# OPENCLAW_DEFAULT_SESSION=agent:main:main

# -- Workspace file access (OPT-IN) ------------------------------------------
# The web "Files" panel browses a local directory through GET /api/workspace/*.
# Unset WORKSPACE_ROOT => no file surface: every workspace request answers
# 503 "workspace is not available". Set it to the agent's workspace directory
# (e.g. ~/.openclaw/workspace) to turn the panel on.
# WORKSPACE_ROOT=/absolute/path/to/workspace
# The path the AGENT sees for that root (defaults to WORKSPACE_ROOT).
# WORKSPACE_AGENT_ROOT=/absolute/path/to/workspace
# Largest file served inline, in bytes (default 8 MB); larger files stream only
# with ?download=1.
# WORKSPACE_MAX_INLINE_BYTES=8388608
# Upload cap (default 100 MB) and total storage quota (default 2 GB), in bytes.
# WORKSPACE_MAX_UPLOAD_BYTES=104857600
# WORKSPACE_QUOTA_BYTES=2147483648
