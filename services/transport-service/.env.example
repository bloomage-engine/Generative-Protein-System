# Copy to `.env` and fill in. Loaded by dotenv at service startup.

# -- Runtime selection -------------------------------------------------------
# Which registered runtime product the service runs: `dsh` (default) or
# `openclaw` (legacy). The module list itself is data (this package's own
# `package.json`, `gps.runtimeModules`; `GPS_RUNTIME_MODULES` overrides it).
TRANSPORT_RUNTIME=dsh

# -- openclaw (legacy; only read when TRANSPORT_RUNTIME=openclaw) ------------
# The default dsh setup does not use a gateway. Uncomment these only when
# explicitly running the legacy openclaw adapter.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=<shared-gateway-token>
# OPENCLAW_DEFAULT_SESSION=agent:main:main

# -- dsh (the default runtime) ------------------------------------------------
# The adapter spawns `dsh --profile sdk` locally. Its LAUNCH knobs — DSH_PROVIDER
# The dev launcher no longer injects a provider or model. The adapter resolves
# the route in this order:
#
#   1. the workbench Settings -> Model (the service settings file)
#   2. `agent-default-model` in <DSH_HOME>/settings.yaml
#   3. the only configured `llm-pi-ai` route that advertises a model
#   4. last resort: `deepseek-official` / `deepseek-v4-flash` (built into dsh,
#      but still requires DEEPSEEK_API_KEY)
#
# The dsh launch knobs — DSH_PROVIDER, DSH_MODEL, DSH_WORKSPACE, DSH_HOME,
# DSH_PROFILE, DSH_TRANSCRIPT_DIR, DSH_DEFAULT_SESSION, DSH_MAX_TOKENS — can NOT
# be spelled in this file: the harness child reads `.env` from its own process
# cwd (the launcher's), and the dsh CLI boot layer HARD-REFUSES any DSH_*/XDG_*/
# DYLD_* key in a project `.env`. Set them in the launch environment instead.
#
# The provider ROUTE (endpoint, model list, credential name) is declared
# harness-side in `<harness home>/settings.yaml` (~/.dsh/settings.yaml). The
# harness's own default selection is:
#
#   agent-default-model:
#     provider: ollama-local
#     model: qwen3.8:latest
#
# and the route that provider needs is:
#
#   llm-pi-ai:
#     providers:
#       ollama-local:
#         api: openai-completions
#         baseURL: http://localhost:11434/v1
#         models: [{ id: qwen3.8:latest }]
#         apiKeyEnv: OLLAMA_LOCAL_API_KEY
#
# A `.env` key here is only the route's CREDENTIAL (its `apiKeyEnv` name must
# be set to a non-empty value — gateways that ignore the bearer, like ollama,
# still fail with MISSING_CREDENTIAL when it is unset). Unlike DSH_*, an
# OLLAMA_LOCAL_API_KEY / DEEPSEEK_API_KEY line is legal in this file: it is
# inherited by the harness child. DeepSeek's own route (`deepseek-official`)
# needs DEEPSEEK_API_KEY.
#
# Ollama ignores the bearer but the harness still requires a non-empty value.
# Uncomment the credential for the route you configured.
# OLLAMA_LOCAL_API_KEY=ollama
# DEEPSEEK_API_KEY=<your-deepseek-api-key>

# -- Project workspace file access (OPT-IN) ----------------------------------
# The web "Files" panel browses a Project's local workspace through
# GET /api/workspace/*. Unset PROJECT_ROOT => no file surface: every workspace
# request answers 503 "workspace is not available".
#
# PROJECT_ROOT is the PARENT of every Project's workspace directory: a Project
# owns `<PROJECT_ROOT>/<projectId>/`, shared by all of its Sessions
# (docs/adr/0006), and the auto-ensured default Project is `project-default`.
# The agent works in the SAME directory: the service provisions one runtime
# adapter per Project, initialized with that Project's workspace, so the dsh
# child's cwd follows the Project the run belongs to (docs/adr/0008). DSH_WORKSPACE
# is therefore only the standalone fallback for a deployment with NO workspace
# (see the dsh block above).
#
# Set this to the parent directory of your projects. Examples:
#   Linux/macOS  PROJECT_ROOT=/data/projects
#   Windows      PROJECT_ROOT=D:/GPS/projects
#   WSL          PROJECT_ROOT=/mnt/d/GPS/projects
# A path with spaces must be quoted: PROJECT_ROOT="D:/Generative Protein System/projects".
#
# (Unset => no file surface, and the web Files toggle disables itself.)
# PROJECT_ROOT=/absolute/path/to/workspace-parent
# The path the AGENT sees for that root (defaults to PROJECT_ROOT). Set this
# when the agent's view differs (e.g. a container mount): agent paths map back
# through it to workspace-relative paths.
# PROJECT_AGENT_ROOT=/absolute/path/to/workspace-parent
# Largest file served inline, in bytes (default 8 MB); larger files stream only
# with ?download=1.
# WORKSPACE_MAX_INLINE_BYTES=8388608
# Upload cap (default 100 MB) and total storage quota (default 2 GB), in bytes.
# WORKSPACE_MAX_UPLOAD_BYTES=104857600
# WORKSPACE_QUOTA_BYTES=2147483648
