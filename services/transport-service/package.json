{
  "name": "@science-studio/transport-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@science-studio/transport": "*",
    "@science-studio/transport-dsh": "*",
    "@science-studio/transport-openclaw": "*",
    "@science-studio/workspace": "*",
    "dotenv": "^16.4.0",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  }
}
