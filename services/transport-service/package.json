{
  "name": "@gps/transport-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@gps/cron": "*",
    "@gps/hpc": "*",
    "@gps/transport": "*",
    "@gps/transport-dsh": "*",
    "@gps/transport-openclaw": "*",
    "@gps/workspace": "*",
    "dotenv": "^16.4.0",
    "fastify": "5.12.3",
    "molstar": "5.9.0"
  },
  "gps": {
    "runtimeModules": [
      "@gps/transport-openclaw",
      "@gps/transport-dsh"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  }
}
