{
  "name": "@science-studio/transport-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "DSH_PROVIDER=${DSH_PROVIDER:-ollama-local} DSH_MODEL=${DSH_MODEL:-qwen3.8:latest} DSH_WORKSPACE=${DSH_WORKSPACE:-$HOME/workspace/dsh-workspace} DSH_DEFAULT_SESSION=${DSH_DEFAULT_SESSION:-science-studio} tsx src/index.ts",
    "dev:dsh": "TRANSPORT_RUNTIME=dsh npm run dev",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@science-studio/transport": "*",
    "@science-studio/transport-dsh": "*",
    "@science-studio/transport-openclaw": "*",
    "@science-studio/workspace": "*",
    "dotenv": "^16.4.0",
    "fastify": "5.12.3",
    "molstar": "5.9.0"
  },
  "scienceStudio": {
    "runtimeModules": [
      "@science-studio/transport-openclaw",
      "@science-studio/transport-dsh"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  }
}
